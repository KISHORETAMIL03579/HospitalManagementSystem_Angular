{
  "name": "hospital-management-system",
  "private": true,
  "scripts": {
    "start": "npm --prefix frontend start",
    "start:backend": "dotnet run --project backend/HospitalManagement.Api/HospitalManagement.Api.csproj",
    "dev": "npm --prefix frontend run dev",
    "dev:full": "concurrently -n \"ANGULAR,BACKEND\" -c \"cyan,magenta\" \"npm --prefix frontend run dev\" \"dotnet run --project backend/HospitalManagement.Api/HospitalManagement.Api.csproj\"",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "dotnet build backend/HospitalManagement.slnx",
    "build:all": "npm run build:frontend && npm run build:backend",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format && dotnet format backend/HospitalManagement.slnx",
    "format:frontend": "npm --prefix frontend run format",
    "format:frontend:check": "npm --prefix frontend run format:check",
    "format:backend": "dotnet format backend/HospitalManagement.slnx",
    "clean": "dotnet clean backend/HospitalManagement.slnx",
    "test": "dotnet test backend/HospitalManagement.slnx"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
