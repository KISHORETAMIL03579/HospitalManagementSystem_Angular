{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5173",
    "dev": "ng serve --port 5173",
    "start:ssl": "ng serve --port 5173 --ssl",
    "start:http": "ng serve --port 5173 --ssl=false",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "lucide-angular": "^0.556.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@tailwindcss/postcss": "^4.0.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
